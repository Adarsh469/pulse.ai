# ── Application ───────────────────────────────────────────────────────────────
# Required: Hugging Face API token (leave blank if not using HF-hosted models)
# On AWS: set via SSM Parameter Store and load with: bash deploy/load-secrets.sh
HF_TOKEN=

# Optional: Default task loaded on backend startup
# Valid values: task1_esi_assignment | task2_queue_priority | task3_ambiguous_triage
DEFAULT_TASK=task1_esi_assignment

# ── AWS (only required on EC2 — leave blank for local development) ─────────────
# AWS region for ECR, CloudWatch logs, and SSM Parameter Store
AWS_REGION=us-east-1

# ECR registry URI — leave blank for local builds
# Format: <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=

# Image tag for ECR pushes (defaults to "latest"; set to git SHA for immutable tags)
IMAGE_TAG=latest
