[Unit]
Description=ClinicalTriage-Env Docker Compose Stack
Documentation=https://github.com/Adarsh469/pulse.ai
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Adjust WorkingDirectory to wherever you cloned the repo
WorkingDirectory=/opt/triage

# Load .env before starting (populated by load-secrets.sh or manually set)
EnvironmentFile=/opt/triage/.env

ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --remove-orphans

TimeoutStartSec=120
TimeoutStopSec=30

Restart=on-failure
RestartSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=triage-compose

[Install]
WantedBy=multi-user.target
